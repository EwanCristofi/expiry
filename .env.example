# Serveur uniquement — ne jamais préfixer VITE_ (sinon exposé au navigateur).
# Sur Vercel : Project Settings → Environment Variables (mêmes clés).
# client_encoding=UTF8 est aussi forcé côté code (server/db.js).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=8787

# Secret du Cron Job Vercel (`Authorization: Bearer …` sur /api/cron/cleanup).
# ≥ 16 caractères alphanumériques ; à définir aussi dans Vercel (Production).
CRON_SECRET=change-me-to-a-long-random-cron-secret

# Compte admin créé par npm run migrate:multitenant
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=demo-admin-change-me
SEED_ADMIN_NOM=Admin Demo

# Admin plateforme (`/admin`) — email et/ou user id UUID.
# Distinct du rôle `admin` d’une officine. Fail-closed si non défini.
ADMIN_EMAIL=vous@example.com
# ADMIN_USER_ID=

# E-mails (Resend) — mot de passe oublié
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Expiry <ne-pas-repondre@expiry.fr>
# URL publique de l’app (liens e-mail reset + origine CORS/CSRF). Serveur uniquement — jamais VITE_*.
# Production : obligatoire, HTTPS uniquement (ex. https://app.example.com).
# Utiliser l’URL canonique (www ou non-www selon la redirection réelle).
# Développement : optionnel ; défaut http://localhost:5173 si absent.
APP_URL=http://localhost:5173

# Origines CORS/CSRF supplémentaires (CSV), comparaison exacte d’origin.
# Toujours inclus automatiquement : APP_URL, http://localhost:5173, http://127.0.0.1:5173.
# Ex. preview Vercel ou www si accessible sans redirection :
# CORS_ORIGINS=https://expiry-git-main-xxx.vercel.app,https://www.example.com
# CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Rate limiting auth (Upstash Redis REST) — Production / Preview obligatoires.
# Ne jamais committer de valeurs. Définir uniquement dans Vercel / secrets locaux.
# Développement local : si absentes, le rate limiting est désactivé explicitement
# (impossible en Production/Preview : réponse 503 tant que non configuré).
# RATE_LIMIT_HMAC_SECRET : secret dédié ≥ 32 octets, distinct de JWT_SECRET.
# ---------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_HMAC_SECRET=
